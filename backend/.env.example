PORT=8010

# Main app DB (mirrors Laravel's "mysql" connection) — required for Master Size, Tag Stock, dll
DB_MAIN_HOST=
DB_MAIN_PORT=3306
DB_MAIN_USER=root
DB_MAIN_PASSWORD=
DB_MAIN_DATABASE=

# EDP source DB (mirrors Laravel's "fginvc" connection) — needed later for Oracle-side data
DB_FGINVC_HOST=
DB_FGINVC_PORT=6447
DB_FGINVC_USER=root
DB_FGINVC_PASSWORD=

# Barcode config DB (mirrors Laravel's "bcmcfgv1" connection)
DB_BCMCFGV1_HOST=
DB_BCMCFGV1_PORT=6447
DB_BCMCFGV1_USER=root
DB_BCMCFGV1_PASSWORD=
